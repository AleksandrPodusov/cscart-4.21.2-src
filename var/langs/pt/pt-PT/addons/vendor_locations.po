msgctxt "Addons::name::vendor_locations"
msgid "Vendor locations [Beta]"
msgstr "Locais de fornecedores [Beta]"

msgctxt "Addons::description::vendor_locations"
msgid "Allows vendors to specify their addresses, so that customers can see distance to vendors and filter products and vendors by their locations."
msgstr "Permite que os fornecedores especifiquem seus endereços, para que os clientes possam ver a distância até os fornecedores e filtrar produtos e fornecedores por suas localizações."

msgctxt "SettingsSections::vendor_locations::general"
msgid "General"
msgstr "Em geral"

msgctxt "SettingsSections::vendor_locations::google"
msgid "Google"
msgstr "Google"

msgctxt "SettingsSections::vendor_locations::yandex"
msgid "Yandex"
msgstr "Yandex"

msgctxt "SettingsOptions::vendor_locations::provider"
msgid "Provider"
msgstr "Fornecedor"

msgctxt "SettingsTooltips::vendor_locations::provider"
msgid "Different map providers store info about locations differently. If you select another map provider, your vendors may have to set their location again."
msgstr "Diferentes provedores de mapas armazenam informações sobre locais de maneira diferente. Se selecionar outro provedor de mapas, seus fornecedores podem ter que definir sua localização novamente."

msgctxt "SettingsVariants::vendor_locations::provider::google"
msgid "Google"
msgstr "Google"

msgctxt "SettingsVariants::vendor_locations::provider::yandex"
msgid "Yandex"
msgstr "Yandex"

msgctxt "SettingsOptions::vendor_locations::yandex_api_key"
msgid "API key"
msgstr "Chave API"

msgctxt "SettingsOptions::vendor_locations::yandex_suggest_api_key"
msgid "Geosuggest API key (Deprecated)"
msgstr "Chave API Geosuggest (Obsoleta)"

msgctxt "SettingsTooltips::vendor_locations::yandex_suggest_api_key"
msgid "This field still works, but will be removed soon. Please connect Geosuggest API to the main API key at <a href=\"https://developer.tech.yandex.ru/keys\" target=\"_blank\">https://developer.tech.yandex.ru/keys</a>."
msgstr "Este campo ainda funciona, mas será removido em breve. Ligue a API Geosuggest à chave da API principal em <a href=\"https://developer.tech.yandex.ru/keys\" target=\"_blank\">https://developer.tech.yandex.ru/keys</a>."

msgctxt "SettingsOptions::vendor_locations::yandex_commercial"
msgid "I use the paid version of the API"
msgstr "Eu uso a versão paga da API"

msgctxt "SettingsOptions::vendor_locations::google_api_key"
msgid "API key"
msgstr "Chave API"

msgctxt "SettingsOptions::vendor_locations::start_search_radius"
msgid "Default radius in distance filter"
msgstr "Raio padrão no filtro de distância"

msgctxt "SettingsTooltips::vendor_locations::start_search_radius"
msgid "You can manually add a product filter that allows customers to search for products within a certain distance if they enter their location. This setting determines the default search radius for that filter. If you don't create a filter, products will be shown regardless of distance, and this setting won't have any effect."
msgstr "Pode adicionar manualmente um filtro de produto que permite que os clientes pesquisem produtos a uma determinada distância se inserirem sua localização. Essa configuração determina o raio de pesquisa padrão para esse filtro. Se não criar um filtro, os produtos serão mostrados independentemente da distância, e essa configuração não terá nenhum efeito."

msgctxt "SettingsOptions::vendor_locations::max_search_radius"
msgid "Maximum radius in distance filter"
msgstr "Raio máximo no filtro de distância"

msgctxt "SettingsTooltips::vendor_locations::max_search_radius"
msgid "You can manually add a product filter that allows customers to search for products within a certain distance if they enter their location. This setting determines the maximum search radius possible for that filter. If you don't create a filter, products will be shown regardless of distance, and this setting won't have any effect."
msgstr "Pode adicionar manualmente um filtro de produto que permite que os clientes pesquisem produtos a uma determinada distância se inserirem sua localização. Essa configuração determina o raio máximo de pesquisa possível para esse filtro. Se não criar um filtro, os produtos serão mostrados independentemente da distância, e essa configuração não terá nenhum efeito."

