msgctxt "Addons::name::hybrid_auth"
msgid "Social login"
msgstr "Login social"

msgctxt "Addons::description::hybrid_auth"
msgid "Adds the Social Login feature; allows customers use Facebook, X, Google, etc. to log in on the store"
msgstr "Adiciona a funcionalidade de login social; permite aos clientes utilizar o Facebook, X, Google, etc. para fazer login na loja."

msgctxt "SettingsSections::hybrid_auth::general"
msgid "General"
msgstr "Em geral"

msgctxt "SettingsOptions::hybrid_auth::icons_pack"
msgid "Icons pack"
msgstr "Pacote de ícones"

msgctxt "SettingsTooltips::hybrid_auth::icons_pack"
msgid "Directory with the social networks icons. A path to the directory: media/images/addons/addons/hybrid_auth/icons/."
msgstr "Diretório com os ícones das redes sociais. Um caminho para o diretório: media/images/addons/addons/hybrid_auth/icons/."

msgctxt "SettingsOptions::hybrid_auth::autogen_email"
msgid "Autogeneration email"
msgstr "E-mail de geração automática"

msgctxt "SettingsTooltips::hybrid_auth::autogen_email"
msgid "Enables the email auto generation in case that a social network does not pass the address."
msgstr "Habilita a geração automática de e-mail caso uma rede social não passe o endereço."

msgctxt "Languages::hybrid_auth"
msgid "Social login"
msgstr "Login social"

msgctxt "Languages::hybrid_auth.linked_provider"
msgid "Linked"
msgstr "Vinculado"

msgctxt "Languages::hybrid_auth.not_linked_provider"
msgid "Not linked"
msgstr "Não ligado"

msgctxt "Languages::hybrid_auth.providers"
msgid "Providers"
msgstr "Provedores"

msgctxt "Languages::hybrid_auth.add_provider"
msgid "Add provider"
msgstr "Adicionar provedor"

msgctxt "Languages::hybrid_auth.new_provider"
msgid "New provider"
msgstr "Novo provedor"

msgctxt "Languages::hybrid_auth.editing_provider"
msgid "Editing provider"
msgstr "Provedor de edição"

msgctxt "Languages::hybrid_auth.callback_url"
msgid "Callback URL"
msgstr "URL de retorno"

msgctxt "Languages::hybrid_auth.social_login"
msgid "Or sign-in with another identity provider"
msgstr "Ou inicie sessão com outro provedor de identidade"

msgctxt "Languages::hybrid_auth.unspecified_error"
msgid "Unspecified error"
msgstr "Erro não especificado"

msgctxt "Languages::hybrid_auth.configuration_error"
msgid "Hybriauth configuration error"
msgstr "Erro de configuração do Hybriauth"

msgctxt "Languages::hybrid_auth.provider_error_configuration"
msgid "Provider not properly configured"
msgstr "Provedor não configurado corretamente"

msgctxt "Languages::hybrid_auth.wrong_provider"
msgid "Unknown or disabled provider"
msgstr "Provedor desconhecido ou desativado"

msgctxt "Languages::hybrid_auth.missing_credentials"
msgid "Missing provider application credentials"
msgstr "Credenciais do aplicativo do provedor ausentes"

msgctxt "Languages::hybrid_auth.failed_auth"
msgid "Authentication failed. The user has canceled the authentication or the provider refused the connection"
msgstr "Falha na autenticação. O utilizador cancelou a autenticação ou o provedor recusou a conexão"

msgctxt "Languages::hybrid_auth.connecting_provider"
msgid "Contacting <b>[provider]</b>. Please wait..."
msgstr "Entrando em contacto com <b>[provider]</b>. Por favor, aguarde..."

msgctxt "Languages::hybrid_auth.cant_create_profile"
msgid "Unfortunately, we failed to create a customer and log in to the store due to one of the following reasons:<br />- You logged in to our store earlier using some other OpenID provider in which the same email is used.<br />- You have already registered in our store using your email.<br />Please contact the store owner to resolve the problems."
msgstr "Infelizmente, não conseguimos criar um cliente e iniciar sessão na loja devido a um dos seguintes motivos:<br />- O utilizador fez login em nossa loja anteriormente usando algum outro provedor OpenID no qual o mesmo e-mail é usado.<br />- Já se cadastrou em nossa loja usando seu e-mail.<br />Contacte o proprietário da loja para resolver os problemas."

msgctxt "Languages::hybrid_auth.password_generated"
msgid "We are glad to inform you that you have been successfully registered in the store. A password was generated for you"
msgstr "Temos o prazer de informar que foi registado com sucesso na loja. Uma palavra-passe foi gerada para si"

msgctxt "Languages::hybrid_auth.change_password"
msgid "You can change your password here"
msgstr "Pode alterar a sua palavra-passe aqui"

msgctxt "Languages::hybrid_auth.link_provider"
msgid "Social network accounts"
msgstr "Contas de redes sociais"

msgctxt "Languages::hybrid_auth.text_link_provider"
msgid "Assign your social network account to this one and use it to log in"
msgstr "Atribua sua conta de rede social a esta e use-a para iniciar sessão"

msgctxt "Languages::hybrid_auth.text_user_is_already_link"
msgid "This social network account is already being used"
msgstr "Esta conta de rede social já está sendo usada"

msgctxt "Languages::hybrid_auth.connect_social"
msgid "Connect social account"
msgstr "Conectar conta social"

msgctxt "Languages::hybrid_auth.connect_social_title"
msgid "Such user already exists"
msgstr "Esse utilizador já existe"

msgctxt "Languages::hybrid_auth.text_connect_social"
msgid "<p>The user with the e-mail specified during social login already exists.</p><p>If you want to assign a social network account to the registered user, please log in.</p>"
msgstr "<p>O utilizador com o e-mail especificado durante o login social já existe.</p><p>Se deseja atribuir uma conta de rede social ao utilizador registado, faça o login.</p>"

msgctxt "Languages::hybrid_auth.specify_email"
msgid "Specify email"
msgstr "Especificar e-mail"

msgctxt "Languages::hybrid_auth.specify_email_title"
msgid "The e-mail was not specified."
msgstr "O e-mail não foi especificado."

msgctxt "Languages::hybrid_auth.text_specify_email"
msgid "<p>When logging through the social network the e-mail was not specified.</p><p>Please enter your e-mail and click Continue.</p>"
msgstr "<p>Ao iniciar sessão pela rede social o e-mail não foi especificado.</p><p>Introduza seu e-mail e clique em Continuar.</p>"

msgctxt "Languages::public_key"
msgid "Public key"
msgstr "Chave pública"

msgctxt "Languages::client_secret"
msgid "Client secret"
msgstr "Segredo do cliente"

msgctxt "Languages::paypal_seamless"
msgid "Use seamless checkout"
msgstr "Use o checkout transparente"

msgctxt "Languages::paypal_sandbox"
msgid "Test mode"
msgstr "Modo de teste"

msgctxt "Languages::privileges.manage_providers"
msgid "Can edit"
msgstr "Pode editar"

msgctxt "Languages::privileges.view_providers"
msgid "Can view"
msgstr "Pode ver"

msgctxt "Languages::privilege_groups.social_login"
msgid "Social login"
msgstr "Login social"

msgctxt "Languages::hybrid_auth.instruction_facebook"
msgid "Use the application ID and Secret key that you've received after creating an application on <a href='https://developers.facebook.com/apps' target='_blank'>Facebook Developers</a>."
msgstr "Use o ID do aplicativo e a chave secreta que recebeu após criar um aplicativo em <a href='https://developers.facebook.com/apps' target='_blank'>Desenvolvedores do Facebook</a>."

msgctxt "Languages::hybrid_auth.instruction_facebook_login"
msgid "Use the application ID and Secret key that you've received after creating an application on <a href=\"https://developers.facebook.com/apps\" target=\"_blank\">Facebook Developers</a>. After that copy the value of the <b>Valid OAuth redirect URIs</b> field to the corresponding setting of the <b>Facebook Login</b> product in your Facebook application."
msgstr "Use o ID do aplicativo e a chave secreta que recebeu após criar um aplicativo em <a href=\"https://developers.facebook.com/apps\" target=\"_blank\">Desenvolvedores do Facebook</a>. Depois disso, copie o valor do campo <b>Valid OAuth redirect URIs</b> para a configuração correspondente do produto <b>Facebook Login</b> em seu aplicativo do Facebook."

msgctxt "Languages::hybrid_auth.instruction_google"
msgid "Use ID and Secret key that you've received after creating a project on <a href='https://code.google.com/apis/console/?pli=1' target='_blank'>Google</a>."
msgstr "Use o ID e a chave secreta que recebeu após criar um projeto no <a href='https://code.google.com/apis/console/?pli=1' target='_blank'>Google</a>."

msgctxt "Languages::hybrid_auth.instruction_paypal"
msgid "Use the application ID and Secret key that you've received after creating an application on <a href='https://developer.paypal.com/developer/applications' target='_blank'>PayPal Developers</a>."
msgstr "Use o ID do aplicativo e a chave secreta que recebeu após criar um aplicativo em <a href='https://developer.paypal.com/developer/applications' target='_blank'>Desenvolvedores do PayPal</a>."

msgctxt "Languages::hybrid_auth.instruction_x"
msgid "Use ID (Consumer key) and Secret key that you've received after creating an application on <a href='https://developer.x.com/' target='_blank'>X</a>."
msgstr "Utilize o ID (chave do consumidor) e a chave secreta que recebeu após criar uma aplicação em <a href='https://developer.x.com/' target='_blank'>X</a>."

msgctxt "Languages::hybrid_auth.instruction_yahoo"
msgid "Use ID (Identificator) and Secret key that you've received after creating an application on <a href='https://developer.yahoo.com/apps/create/' target='_blank'>Yahoo</a>."
msgstr "Use o ID (Identificador) e a chave secreta que recebeu após criar um aplicativo em <a href='https://developer.yahoo.com/apps/create/' target='_blank'>Yahoo</a>."

msgctxt "Languages::hybrid_auth.instruction_live"
msgid "Use the application ID and Secret key that you've received after adding an application on <a href='https://account.live.com/developers/applications/create' target='_blank'>Live</a>."
msgstr "Use o ID do aplicativo e a chave secreta que recebeu após adicionar um aplicativo em <a href='https://account.live.com/developers/applications/create' target='_blank'>Live</a>."

msgctxt "Languages::hybrid_auth.instruction_linkedin"
msgid "Use ID (Consumer key) and Secret key that you've received after creating an application on <a href='https://www.linkedin.com/developer/apps' target='_blank'>LinkedIn Developers</a>."
msgstr "Use a ID (chave do consumidor) e a chave secreta que recebeu após criar um aplicativo em <a href='https://www.linkedin.com/developer/apps' target='_blank'>LinkedIn Developers</a>."

msgctxt "Languages::hybrid_auth.instruction_foursquare"
msgid "Use the application ID and Secret key that you've received after creating an application on <a href='https://foursquare.com/developers/apps' target='_blank'>Fousquare</a>."
msgstr "Use o ID do aplicativo e a chave secreta que recebeu após criar um aplicativo em <a href='https://foursquare.com/developers/apps' target='_blank'>Fousquare</a>."

msgctxt "Languages::hybrid_auth.instruction_telegram"
msgid "Use the bot ID (name) and Secret token that you've received after creating a bot in Telegram app. Also you should set domain using '/setdomain'. See: <a href='https://core.telegram.org/bots' target='_blank'>Telegram bots</a>."
msgstr "Use o ID do bot (nome) e o token secreto que recebeu após criar um bot no aplicativo Telegram. Além disso, deve definir o domínio usando '/setdomain'. Veja: <a href='https://core.telegram.org/bots' target='_blank'>Bots de telegrama</a>."

msgctxt "Languages::hybrid_auth.telegram.bot_id"
msgid "Bot ID (name)"
msgstr "ID do bot (nome)"

msgctxt "Languages::hybrid_auth.telegram.bot_token"
msgid "Bot token"
msgstr "Token de bot"

msgctxt "Languages::email_template.hybrid_auth_create_profile"
msgid "Create user profile via social login"
msgstr "Criar perfil de utilizador via login social"

msgctxt "Languages::hybrid_auth.provider_not_found"
msgid "Provider [provider] not found"
msgstr "Provedor [provider] não encontrado"

msgctxt "Languages::hybrid_auth.facebook_oauth_redirect_uris"
msgid "Valid OAuth redirect URIs"
msgstr "URIs de redirecionamento OAuth válidos"

msgctxt "Languages::hybrid_auth.live_redirect_urls"
msgid "Redirect URLs"
msgstr "URLs de redirecionamento"

msgctxt "Languages::hybrid_auth.linkedin_api_version"
msgid "API version"
msgstr "Versão da API"

msgctxt "Languages::ttc_hybrid_auth.linkedin_api_version"
msgid "LinkedIn <a target=\"_blank\" href=\"https://docs.microsoft.com/en-us/linkedin/consumer/integrations/self-serve/migration-faq?context=linkedin/consumer/context\">deprecated API v1</a>, but old apps still use it. If you're configuring LinkedIn app for the first time now, use API v2. Old LinkedIn apps configured some time ago may still be using v1."
msgstr "O LinkedIn <a target=\"_blank\" href=\"https://docs.microsoft.com/en-us/linkedin/consumer/integrations/self-serve/migration-faq?context=linkedin/consumer/context\">preteriu a API v1</a>, mas aplicativos antigos ainda a usam. Se estiver configurando o aplicativo LinkedIn pela primeira vez agora, use a API v2. Aplicativos antigos do LinkedIn configurados há algum tempo ainda podem estar usando v1."

msgctxt "Languages::hybrid_auth.linkedin_api_v1"
msgid "v1"
msgstr "v1"

msgctxt "Languages::hybrid_auth.linkedin_api_v2"
msgid "v2"
msgstr "v2"

msgctxt "Languages::hybrid_auth.instruction_paypal_application"
msgid "Use the application ID and Secret key that you've received after creating an application on <a href='https://developer.paypal.com/developer/applications' target='_blank'>PayPal Developers</a>. Please enable all Personal Profile scope attributes and at least one scope attribute in Address and in Account Information in your PayPal application settings."
msgstr "Use o ID do aplicativo e a chave secreta que recebeu após criar um aplicativo em <a href='https://developer.paypal.com/developer/applications' target='_blank'>Desenvolvedores do PayPal</a>. Ative todos os atributos de escopo do Perfil pessoal e pelo menos um atributo de escopo em Endereço e em Informações da conta nas configurações do seu aplicativo do PayPal."

msgctxt "Languages::hybrid_auth_menu_description"
msgid "Connect users via Facebook, X, Google, etc."
msgstr "Ligue utilizadores via Facebook, X, Google, etc."

