msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.automatically.tooltip"
msgid "If any of a product's variations are \"separate products\", then all variations of that product will use unique names from offers.xml"
msgstr "Falls Varianten eines Produkts als „separate Produkte“ gelten, erhalten alle Varianten dieses Produkts eindeutige Namen aus der Datei offers.xml."

