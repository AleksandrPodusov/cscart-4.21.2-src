msgctxt "Addons::name::yandex_delivery"
msgid "Yandex Delivery"
msgstr "Яндекс Доставка"

msgctxt "Addons::description::yandex_delivery"
msgid "Integration with Yandex Delivery for next-day shipping in Russia."
msgstr "Интеграция с Яндекс Доставкой по России с доставкой на следующий день."

msgctxt "Languages::yandex_delivery.carrier"
msgid "Yandex Delivery"
msgstr "Яндекс Доставка"

msgctxt "Languages::yandex_delivery.auth_token"
msgid "Bearer token"
msgstr "Токен доступа"

msgctxt "Languages::yandex_delivery.auth_token.tooltip"
msgid "Get the token in the <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/api/other-day/access\" target=\"_blank\" rel=\"noopener noreferrer\">Yandex Delivery account profile</a>."
msgstr "Получить токен в <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/api/other-day/access\" target=\"_blank\" rel=\"noopener noreferrer\">профиле аккаунта Яндекс Доставки</a>."

msgctxt "Languages::yandex_delivery.auth_token_required"
msgid "Yandex Delivery: Enter the Bearer token in the shipping method settings."
msgstr "Яндекс Доставка: Введите токен доступа в настройках способа доставки."

msgctxt "Languages::yandex_delivery.connection"
msgid "Connection"
msgstr "Подключение"

msgctxt "Languages::yandex_delivery.environment"
msgid "Environment"
msgstr "Среда"

msgctxt "Languages::yandex_delivery.environment.production"
msgid "Production"
msgstr "Рабочая"

msgctxt "Languages::yandex_delivery.environment.sandbox"
msgid "Sandbox"
msgstr "Тестовая"

msgctxt "Languages::yandex_delivery.environment.tooltip"
msgid "The sandbox and production environments use different tokens, and a warehouse from one environment does not exist in the other. After switching, pick the warehouse again."
msgstr "Тестовая и рабочая среда используют разные токены; склад в одной среде не существует в другой среде. После переключения среды выберите склад заново. "

msgctxt "Languages::yandex_delivery.handover"
msgid "Handover to Yandex"
msgstr "Передача в Яндекс"

msgctxt "Languages::yandex_delivery.handover_scheme"
msgid "Handover scheme"
msgstr "Схема передачи"

msgctxt "Languages::yandex_delivery.handover_scheme.courier"
msgid "A Yandex courier picks parcels up at my warehouse"
msgstr "Курьер Яндекса забирает посылки с моего склада"

msgctxt "Languages::yandex_delivery.handover_needs_token"
msgid "To make this section available, save the shipping method with a valid token."
msgstr "Чтобы включить эту опцию, сохраните способ доставки с действующим токеном."

msgctxt "Languages::yandex_delivery.warehouses_stale"
msgid "The token or the environment has changed. The warehouse lists below still come from the previous one — save the shipping method to reload them."
msgstr "Токен или среда были изменены. Списки складов ниже относятся к предыдущим настройкам. Сохраните способ доставки, чтобы обновить списки складов."

msgctxt "Languages::yandex_delivery.warehouse_reset"
msgid "Yandex Delivery: the selected warehouse was cleared because the token or the environment has changed. Warehouse IDs only work in the account they were picked in, so choose a warehouse again."
msgstr "Яндекс Доставка: выбранный склад сброшен, так как изменился токен или среда. ID склада действует только в аккаунте, в котором он был выбран. Выберите склад заново."

msgctxt "Languages::yandex_delivery.check"
msgid "Check connection"
msgstr "Проверить подключение"

msgctxt "Languages::yandex_delivery.check.token_ok"
msgid "Yandex Delivery accepted the token. Warehouses on the account: [count]."
msgstr "Токен Яндекс Доставки принят. Складов в аккаунте: [count]."

msgctxt "Languages::yandex_delivery.check.token_failed"
msgid "Could not check the connection: [error]"
msgstr "Не удалось проверить подключение: [error]"

msgctxt "Languages::yandex_delivery.handover_scheme.dropoff"
msgid "I bring parcels to a Yandex drop-off point myself"
msgstr "Я самостоятельно отвожу посылки в пункт приема Яндекс Доставки"

msgctxt "Languages::yandex_delivery.source_platform_station_id"
msgid "My warehouse"
msgstr "Мой склад"

msgctxt "Languages::yandex_delivery.source_platform_station_id.tooltip"
msgid "Warehouses are created in the Yandex Delivery account: add the address in the Addresses section, then open Shipment calendar and pick it there. <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/add-address\" target=\"_blank\" rel=\"noopener noreferrer\">Yandex instructions</a>."
msgstr "Склады создаются в аккаунте Яндекс Доставки: добавьте адрес в раздел \"Адреса\", затем выберите его в \"Календаре отгрузок\". <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/add-address\" target=\"_blank\" rel=\"noopener noreferrer\">Инструкции Яндекса</a>."

msgctxt "Languages::yandex_delivery.source_platform_station_id_required"
msgid "Yandex Delivery: Select a shipping warehouse in the shipping method settings."
msgstr "Яндекс Доставка: выберите склад отгрузки в настройках способа доставки."

msgctxt "Languages::yandex_delivery.pickup_unavailable"
msgid "Yandex returns no pickup dates for this warehouse. Check that its city is in the <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/rules#cities\" target=\"_blank\" rel=\"noopener noreferrer\">list of cities with courier pickup</a> and that the address falls inside the service zone on the map. Otherwise switch to bringing parcels to a Yandex warehouse yourself."
msgstr "Яндекс не находит даты забора посылок для этого склада. Убедитесь, что выбранный город входит в <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/rules#cities\" target=\"_blank\" rel=\"noopener noreferrer\">список городов, где доступен забор посылок курьером</a> , а указанный адрес входит в зону обслуживания на карте. Если нет, выберите самостоятельную передачу посылок на склад Яндекс Доставки."

msgctxt "Languages::yandex_delivery.pickup_not_scheduled"
msgid "Pickup from this warehouse is available but not scheduled. Schedule it in the <a class=\"underline\" href=\"https://dostavka.yandex.ru/account/shipment\" target=\"_blank\" rel=\"noopener noreferrer\">Shipment calendar</a>: without a scheduled pickup Yandex quotes no price and the shipping method stays hidden at checkout."
msgstr "Забор посылок с этого склада доступен, но не запланирован. Запланируйте его в <a class=\"underline\" href=\"https://dostavka.yandex.ru/account/shipment\" target=\"_blank\" rel=\"noopener noreferrer\">Календаре отгрузок</a>, чтобы Яндекс рассчитал стоимость доставки и показал способ доставки при оформлении заказа."

msgctxt "Languages::yandex_delivery.dropoff_city"
msgid "City"
msgstr "Город"

msgctxt "Languages::yandex_delivery.dropoff_city.tooltip"
msgid "Defines where to look for drop-off points. The region is shown next to each city because the same name occurs several times across the country."
msgstr "Определяет, где искать пункты приема посылок. Рядом с каждым городом указан регион, поскольку встречаются города с одинаковыми названиями."

msgctxt "Languages::yandex_delivery.station_type.warehouse"
msgid "Hub"
msgstr "СЦ"

msgctxt "Languages::yandex_delivery.station_type.warehouse.description"
msgid "Sorting centre"
msgstr "Сортировочный центр"

msgctxt "Languages::yandex_delivery.station_type.pickup_point"
msgid "Point"
msgstr "ПВЗ"

msgctxt "Languages::yandex_delivery.station_type.pickup_point.description"
msgid "Pickup point"
msgstr "Пункт самовывоза"

msgctxt "Languages::yandex_delivery.station_type.limits_note"
msgid "Volume and size limits are listed in the Yandex Delivery <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/rules\" target=\"_blank\" rel=\"noopener noreferrer\">shipping rules</a>."
msgstr "Ограничения по объему и размеру посылок см. в <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/rules\" target=\"_blank\" rel=\"noopener noreferrer\">правилах Яндекс Доставки</a>."

msgctxt "Languages::yandex_delivery.dropoff_platform_station_id"
msgid "Drop-off point"
msgstr "Пункт приема посылок"

msgctxt "Languages::yandex_delivery.dropoff_platform_station_id_required"
msgid "Yandex Delivery: Select a drop-off point in the shipping method settings."
msgstr "Яндекс Доставка: пункт приема посылок в настройках способа доставки."

msgctxt "Languages::yandex_delivery.delivery"
msgid "Delivery to the customer"
msgstr "Доставка покупателю"

msgctxt "Languages::yandex_delivery.delivery_type"
msgid "Delivery type"
msgstr "Способ вручения"

msgctxt "Languages::yandex_delivery.delivery_type.time_interval"
msgid "Door delivery"
msgstr "До двери"

msgctxt "Languages::yandex_delivery.delivery_type.self_pickup"
msgid "Pickup point delivery"
msgstr "До пункта самовывоза"

msgctxt "Languages::yandex_delivery.package"
msgid "Default parcel dimensions"
msgstr "Габариты посылки по умолчанию"

msgctxt "Languages::yandex_delivery.dimensions"
msgid "Length, width, height"
msgstr "Длина, ширина, высота"

msgctxt "Languages::yandex_delivery.dimensions.tooltip"
msgid "Used when a product has no box dimensions of its own. A product's own dimensions apply only together with \"items in box\"."
msgstr "Применяется, когда у товара не заданы габариты коробки. Габариты товара учитываются только со значением \"штук в коробке\"."

msgctxt "Languages::yandex_delivery.dimensions_all_required"
msgid "Fill in all three: Yandex Delivery will not quote a rate without the length, width and height."
msgstr "Заполните все три поля: длину, ширину и высоту. Без них невозможно рассчитать стоимость Яндекс Доставки."

msgctxt "Languages::yandex_delivery.cm"
msgid "cm"
msgstr "см"

msgctxt "Languages::yandex_delivery.destination_address_required"
msgid "Yandex Delivery: Enter the recipient address."
msgstr "Яндекс Доставка: Введите адрес получателя."

msgctxt "Languages::yandex_delivery.dimensions_required"
msgid "Yandex Delivery: Enter default parcel dimensions in the shipping method settings or specify box dimensions for products."
msgstr "Яндекс Доставка: Введите габариты посылки по умолчанию в настройках способа доставки или задайте габариты коробки для товаров."

msgctxt "Languages::yandex_delivery.schedule.daily"
msgid "Daily"
msgstr "Ежедневно"

msgctxt "Languages::yandex_delivery.schedule.utc_offset"
msgid "UTC[offset]"
msgstr "UTC[offset]"

msgctxt "Languages::yandex_delivery.error.pickups_not_configured"
msgid "The warehouse has no scheduled shipment. Schedule one in the Yandex Delivery shipment calendar."
msgstr "Отгрузка не запланирована для склада. Запланируйте ее в календаре отгрузок Яндекс Доставки."

msgctxt "Languages::yandex_delivery.error.no_delivery_options"
msgid "Yandex Delivery has no route for this parcel."
msgstr "Яндекс Доставка не может построить маршрут для этой посылки."

msgctxt "Languages::yandex_delivery.error.parcel_over_limit"
msgid "The order exceeds the Yandex Delivery weight and dimension limits."
msgstr "Заказ превышает ограничения Яндекс Доставки по весу и габаритам."

msgctxt "Languages::yandex_delivery.error.dimensions_limit"
msgid "The parcel exceeds the Yandex Delivery size or weight limit."
msgstr "Посылка превышает ограничения Яндекс Доставки по размеру или весу."

msgctxt "Languages::yandex_delivery.error.unauthorized"
msgid "Yandex Delivery did not accept the token."
msgstr "Токен Яндекс Доставки не принят."

msgctxt "Languages::yandex_delivery.error.forbidden"
msgid "The token has no access to this Yandex Delivery request."
msgstr "У токена нет доступа к этому запросу Яндекс Доставки."

msgctxt "Languages::yandex_delivery.error.not_found"
msgid "Yandex Delivery did not find the requested object."
msgstr "Яндекс Доставка не нашла запрошенный объект."

msgctxt "Languages::yandex_delivery.error.too_many_requests"
msgid "Too many requests to Yandex Delivery. Try again later."
msgstr "Превышено число запросов к Яндекс Доставке. Попробуйте позже."

msgctxt "Languages::yandex_delivery.error.server"
msgid "Yandex Delivery is temporarily unavailable."
msgstr "Яндекс Доставка временно не доступна."

msgctxt "Languages::yandex_delivery.error.http"
msgid "Yandex Delivery responded with error [status]."
msgstr "Яндекс Доставка вернула ошибку [status]."

msgctxt "Languages::yandex_delivery.empty_response"
msgid "Yandex Delivery returned an empty response."
msgstr "Яндекс Доставка вернула пустой ответ."

msgctxt "Languages::yandex_delivery.invalid_response"
msgid "Yandex Delivery returned an invalid response."
msgstr "Яндекс Доставка вернула некорректный ответ."

msgctxt "Languages::yandex_delivery.error_calculate"
msgid "Yandex Delivery calculation error."
msgstr "Ошибка расчета Яндекс Доставки."

msgctxt "Languages::yandex_delivery.label_unavailable"
msgid "The Yandex Delivery label file could not be read. Try again."
msgstr "Не удалось прочитать файл ярлыка Яндекс Доставки. Повторите попытку."

msgctxt "Languages::yandex_delivery.rate_calculation_failed"
msgid "An error occurred. Please try again."
msgstr "Произошла ошибка. Попробуйте еще раз."

msgctxt "Languages::yandex_delivery.selected_pickup_point_unavailable"
msgid "This pickup point is not available. Please select another."
msgstr "Этот пункт самовывоза недоступен. Выберите другой пункт самовывоза."

msgctxt "Languages::yandex_delivery.pickup_point_required"
msgid "Yandex Delivery: Select a pickup point for this shipment."
msgstr "Яндекс Доставка: выберите пункт самовывоза для этого отправления."

msgctxt "Languages::yandex_delivery.pickup_point"
msgid "Yandex Delivery pickup point"
msgstr "Пункт самовывоза Яндекс Доставки"

msgctxt "Languages::yandex_delivery.recipient_phone_required"
msgid "Yandex Delivery: Enter the recipient phone number."
msgstr "Яндекс Доставка: Введите номер телефона получателя."

msgctxt "Languages::yandex_delivery.shipment_products_required"
msgid "Yandex Delivery: The shipment has no products."
msgstr "Яндекс Доставка: В вашем отправлении нет товаров."

msgctxt "Languages::yandex_delivery.shipment_not_found"
msgid "Yandex Delivery: Shipment not found."
msgstr "Яндекс Доставка: Отправление не найдено."

msgctxt "Languages::yandex_delivery.order_not_found"
msgid "Yandex Delivery: Order not found."
msgstr "Яндекс Доставка: Заказ не найден."

msgctxt "Languages::yandex_delivery.shipping_method_not_found"
msgid "Yandex Delivery: Shipping method not found."
msgstr "Яндекс Доставка: Способ доставки не найден."

msgctxt "Languages::yandex_delivery.not_yandex_delivery_shipment"
msgid "Yandex Delivery: This shipment does not belong to Yandex Delivery."
msgstr "Яндекс Доставка: Данное отправление не относится к Яндекс Доставке."

msgctxt "Languages::yandex_delivery.request_id_not_found"
msgid "Yandex Delivery did not return the request ID."
msgstr "Яндекс Доставка не вернула ID запроса."

msgctxt "Languages::yandex_delivery.no_request_id"
msgid "Yandex Delivery request has not been created for this shipment yet."
msgstr "Яндекс Доставка: Запрос для этого отправления еще не был создан."

msgctxt "Languages::yandex_delivery.cancel_refused"
msgid "Yandex refused to cancel the delivery without explaining why."
msgstr "Яндекс Доставка: Не удалось отменить доставку, причина неизвестна."

msgctxt "Languages::yandex_delivery.cancel_failed_shipment_kept"
msgid "The shipment was not deleted: [error]"
msgstr "Отправление не было удалено: [error]"

msgctxt "Languages::yandex_delivery.cancel_already_done"
msgid "Deliveries of these shipments have already been called off and cannot be brought back: [shipments]."
msgstr "Доставка этих отправлений уже была отменена; восстановление невозможно: [shipments]."

msgctxt "Languages::yandex_delivery.cancel_failed_order_kept"
msgid "The order was not deleted: [error]"
msgstr "Заказ не был удален: [error]"

msgctxt "Languages::yandex_delivery.request_created"
msgid "Yandex Delivery request [request_id] has been created."
msgstr "Запрос в Яндекс Доставку [request_id] создан."

msgctxt "Languages::yandex_delivery.status_updated"
msgid "Yandex Delivery status has been updated."
msgstr "Статус Яндекс Доставки обновлен."

msgctxt "Languages::yandex_delivery.request"
msgid "Yandex Delivery request"
msgstr "Запрос в Яндекс Доставку"

msgctxt "Languages::yandex_delivery.request_id"
msgid "Yandex request ID"
msgstr "ID запроса в Яндекс Доставку"

msgctxt "Languages::yandex_delivery.status"
msgid "Yandex Delivery status"
msgstr "Статус Яндекс Доставки"

msgctxt "Languages::yandex_delivery.not_sent"
msgid "Not sent to Yandex Delivery"
msgstr "Не отправлено в Яндекс Доставку"

msgctxt "Languages::yandex_delivery.create_request"
msgid "Send to Yandex Delivery"
msgstr "Отправлено в Яндекс Доставку"

msgctxt "Languages::yandex_delivery.update_status"
msgid "Update Yandex Delivery status"
msgstr "Обновить статус Яндекс Доставки"

msgctxt "Languages::yandex_delivery.print_label"
msgid "Print Yandex Delivery label"
msgstr "Печатать бланк Яндекс Доставки"

msgctxt "Languages::yandex_delivery.print_labels"
msgid "Print Yandex Delivery labels"
msgstr "Печатать бланки Яндекс Доставки"

