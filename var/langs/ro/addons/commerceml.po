msgid "Use names from CRM everywhere in CS-Cart"
msgstr "Folosește nume din CRM peste tot în CS-Cart"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names.both.tooltip"
msgid "Feature names in CS-Cart will change to match the names in your CRM. Any changes to feature names on the CS-Cart end will be lost."
msgstr "Numele funcțiilor din CS-Cart se vor schimba pentru a corespunde cu numele din CRM-ul dvs. Orice modificare a numelor funcțiilor din partea CS-Cart se va pierde."

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names.no"
msgid "Do not use names from CRM"
msgstr "Nu folosiți nume din CRM"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names.no.tooltip"
msgid "Feature names will come from CRM only on first import. Subsequent changes in the CRM won't affect existing feature names in CS-Cart."
msgstr "Numele funcțiilor vor proveni din CRM doar la prima importare. Modificările ulterioare din CRM nu vor afecta numele funcțiilor existente în CS-Cart."

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names"
msgid "Names of feature variants"
msgstr "Numele variantelor de caracteristici"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names.yes"
msgid "Use names from CRM"
msgstr "Folosește nume din CRM"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names.yes.tooltip"
msgid "Feature variant names will always be updated from the CRM. Your edits will be lost on import."
msgstr "Numele variantelor de funcții vor fi întotdeauna actualizate din CRM. Modificările dvs. se vor pierde la import."

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names.no"
msgid "Do not use names from CRM"
msgstr "Nu folosiți nume din CRM"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names.no.tooltip"
msgid "Feature variant names will come from CRM only on first import. Useful if you plan to change their names in CS-Cart."
msgstr "Numele variantelor de funcții vor proveni din CRM doar la primul import. Util dacă intenționați să le schimbați numele în CS-Cart."

msgctxt "Languages::commerceml.cml_catalog_sync_feature.vendor_notice"
msgid "The settings about the names of product features and their variants only affect the product features that belong to you, not to the marketplace."
msgstr "Setările privind numele caracteristicilor produselor și variantele acestora afectează doar caracteristicile produselor care vă aparțin, nu și pieței."

