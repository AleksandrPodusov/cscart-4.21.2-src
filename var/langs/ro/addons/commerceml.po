msgctxt "Addons::name::commerceml"
msgid "CommerceML Integration"
msgstr "Integrare CommerceML"

msgctxt "Addons::description::commerceml"
msgid "Allows you to import products from and export orders to CRMs that support CommerceML."
msgstr "Vă permite să importați produse din și să exportați comenzi către CRM-uri care acceptă CommerceML."

msgctxt "Languages::commerceml.map.no_available_data.marketplace"
msgid "No data is available. It usually appears here after you successfully connect your CRM to the marketplace."
msgstr "Nu sunt disponibile date. De obicei, acestea apar aici după ce conectați cu succes CRM-ul la marketplace."

msgctxt "Languages::commerceml.map.no_available_data.store"
msgid "No data is available. It usually appears here after you successfully connect your CRM to the store."
msgstr "Nu sunt disponibile date. De obicei, acestea apar aici după ce conectați cu succes CRM-ul la magazin."

