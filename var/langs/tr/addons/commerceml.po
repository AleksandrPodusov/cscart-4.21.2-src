msgstr "Katalog adlarını kullanın."

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.import.tooltip"
msgid "All variations of a product will use their common catalog name from import.xml"
msgstr "Bir ürünün tüm varyasyonları, import.xml dosyasındaki ortak katalog adını kullanacaktır."

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.offers"
