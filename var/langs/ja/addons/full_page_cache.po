msgctxt "Addons::name::full_page_cache"
msgid "Performance Booster"
msgstr "パフォーマンス・ブースター"

msgctxt "Addons::description::full_page_cache"
msgid "Set up full-page cache powered by Varnish to speed up your site under heavy workload."
msgstr "高負荷時におけるサイトの高速化のため、Varnishを利用したフルページキャッシュを設定します。"

msgctxt "Languages::full_page_cache.unable_to_enable_full_page_caching"
msgid "Unable to enable full-page caching."
msgstr "フルページキャッシュを有効化できませんでした。"

msgctxt "Languages::full_page_cache.unable_to_connect_to_varhish"
msgid "Unable to connect to Varnish server. Please make sure that Varnish service is running and check the entered address and port."
msgstr "Varnishサーバーに接続できません。Varnishサービスが実行されていることを確認し、入力したアドレスとポートを確認してください。"

msgctxt "Languages::full_page_cache.error_session_auto_start_enabled"
msgid "The \"session.auto_start\" PHP configuration option is enabled. Please, disable this option by setting \"session.auto_start = 0\" in your php.ini file."
msgstr "PHPの設定オプション「session.auto_start」が有効になっています。php.iniファイルで「session.auto_start = 0」と設定し、このオプションを無効にしてください。"

msgctxt "Languages::full_page_cache.notice_caching_was_enabled"
msgid "Full-page caching have been successfully enabled, started and running."
msgstr "フルページキャッシュは正常に有効化、開始、実行中です。"

msgctxt "Languages::full_page_cache.warning_root_dir_not_writable"
msgid "<strong>Performance Booster:</strong> Root directory of your site isn't writable. Couldn't create symlink to esi.php in the root directory. Please make the directory writable and activate the add-on. Alternatively, create the symlink from the root directory to app/addons/full_page_cache/esi.php manually."
msgstr "<strong>パフォーマンス・ブースター</strong>：サイトのルートディレクトリが書き込み不可です。ルートディレクトリにesi.phpへのシンボリックリンクを作成できませんでした。ディレクトリを書き込み可能にし、アドオンを有効化してください。または、ルートディレクトリからapp/addons/full_page_cache/esi.phpへのシンボリックリンクを手動で作成してください。"

msgctxt "Languages::full_page_cache.failed_to_create_symlink"
msgid "Failed to create symlink [file]"
msgstr "シンボリックリンク[file]の作成に失敗しました。"

msgctxt "Languages::full_page_cache.notice_configure_addon"
msgid "Before you can activate Performance Booster, you'll need to <a href=\"[url]\">configure the server and the add-on.</a>"
msgstr "パフォーマンス・ブースターを有効化する前に、 <a href=\"[url]\">サーバーとアドオン</a>の設定が必要です。"

msgctxt "Languages::full_page_cache.text_settings_general"
msgid "This add-on will only work after proper server configuration. <a target=\"_blank\" href=\"[docs_url]user_guide/addons/full_page_cache/configure.html\">Learn more about how to configure caching on your server</a>."
msgstr "このアドオンは、サーバーの設定を適切に行った後にのみ動作します。<a target=\"_blank\" href=\"[docs_url]user_guide/addons/full_page_cache/configure.html\">サーバーでのキャッシュ設定方法</a>の詳細はこちら。"

msgctxt "SettingsOptions::full_page_cache::varnish"
msgid "Varnish"
msgstr "Varnish"

msgctxt "SettingsOptions::full_page_cache::varnish_host"
msgid "Host"
msgstr "ホスト"

