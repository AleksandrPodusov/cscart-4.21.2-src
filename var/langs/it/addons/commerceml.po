msgstr "Utilizzare i nomi dei cataloghi"

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.import.tooltip"
msgid "All variations of a product will use their common catalog name from import.xml"
msgstr "Tutte le varianti di un prodotto utilizzeranno il loro nome di catalogo comune, come specificato nel file import.xml."

