msgstr "Utilizzare i nomi delle offerte"

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.offers.tooltip"
msgid "All variations of a product will use their unique offer names from offers.xml"
msgstr "Tutte le varianti di un prodotto utilizzeranno i propri nomi di offerta univoci, definiti nel file offers.xml."

