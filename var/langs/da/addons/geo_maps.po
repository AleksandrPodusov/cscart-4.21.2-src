msgctxt "Addons::name::geo_maps"
msgid "Maps and geolocation"
msgstr "Kort og geolokation"

msgctxt "Addons::description::geo_maps"
msgid "Enables Google or Yandex maps and geolocation functionality in your store."
msgstr "Aktiverer Google- eller Yandex-kort og geolokationsfunktionalitet i din butik."

msgctxt "SettingsSections::geo_maps::general"
msgid "General"
msgstr "Generel"

msgctxt "SettingsSections::geo_maps::google"
msgid "Google"
msgstr "Google"

msgctxt "SettingsSections::geo_maps::yandex"
msgid "Yandex"
msgstr "Yandex"

msgctxt "SettingsOptions::geo_maps::provider"
msgid "Provider"
msgstr "Udbyder"

msgctxt "SettingsVariants::geo_maps::provider::google"
msgid "Google"
msgstr "Google"

msgctxt "SettingsVariants::geo_maps::provider::yandex"
msgid "Yandex"
msgstr "Yandex"

msgctxt "SettingsOptions::geo_maps::show_shippings_on_product"
msgid "Show shipping cost and time on product pages"
msgstr "Vis forsendelsesomkostninger og tid på produktsider"

msgctxt "SettingsOptions::geo_maps::yandex_api_key"
msgid "API key"
msgstr "API nøgle"

msgctxt "SettingsOptions::geo_maps::yandex_suggest_api_key"
msgid "Geosuggest API key (Deprecated)"
msgstr "Geosuggest API-nøgle (udfaset)"

msgctxt "SettingsTooltips::geo_maps::yandex_suggest_api_key"
msgid "This field still works, but will be removed soon. Please connect Geosuggest API to the main API key at <a href=\"https://developer.tech.yandex.ru/keys\" target=\"_blank\">https://developer.tech.yandex.ru/keys</a>."
msgstr "Dette felt fungerer stadig, men vil snart blive fjernet. Forbind venligst Geosuggest API til den primære API-nøgle på <a href=\"https://developer.tech.yandex.ru/keys\" target=\"_blank\">https://developer.tech.yandex.ru/keys</a>."

msgctxt "SettingsOptions::geo_maps::yandex_commercial"
msgid "I use the paid version of the API"
msgstr "Jeg bruger den betalte version af API"

msgctxt "SettingsOptions::geo_maps::google_api_key"
msgid "API key"
msgstr "API nøgle"

msgctxt "Languages::geo_maps.select_your_city"
msgid "Select your city"
msgstr "Vælg din by"

msgctxt "Languages::geo_maps.your_city"
msgid "Your city"
msgstr "Din by"

msgctxt "Languages::geo_maps.location_detection_disabled"
msgid "Your location could not be determined. Try enabling the location services on your device or disabling the tracking protection."
msgstr "Din placering kunne ikke bestemmes. Prøv at aktivere placeringstjenesterne på din enhed eller deaktivere sporingsbeskyttelsen."

msgctxt "Languages::block_geo_maps_customer_location"
msgid "Customer location"
msgstr "Kundens placering"

msgctxt "Languages::block_geo_maps_customer_location_description"
msgid "Customer city and city selection form"
msgstr "Formular til valg af kundeby og by"

msgctxt "Languages::geo_maps.shipping_address_on_map"
msgid "Shipping address on map"
msgstr "Leveringsadresse på kort"

msgctxt "Languages::geo_maps.cannot_select_location"
msgid "This location couldn't be selected due to technical reasons. If you encounter any difficulties when placing an order, please contact us."
msgstr "Denne placering kunne ikke vælges af tekniske årsager. Hvis du støder på problemer, når du afgiver en ordre, bedes du kontakte os."

msgctxt "Languages::geo_maps.shipping_time_and_rates"
msgid "Shipping time and rates"
msgstr "Leveringstid og priser"

msgctxt "Languages::geo_maps.shipping_group_pickup"
msgid "Pick-up"
msgstr "Saml op"

msgctxt "Languages::geo_maps.shipping_group_delivery"
msgid "Shipping"
msgstr "Forsendelse"

msgctxt "Languages::geo_maps.from_pickup_points"
msgid "[shipping], [n] pickup point|[shipping], [n] pickup points"
msgstr "[shipping], [n] afhentningssted|[shipping], [n] afhentningspunkter"

msgctxt "Languages::geo_maps.shipping_about"
msgid "about"
msgstr "om"

msgctxt "Languages::geo_maps.shipping_from"
msgid "from"
msgstr "fra"

msgctxt "Languages::geo_maps.shipping_time"
msgid "Shipping time"
msgstr "Forsendelsestid"

msgctxt "Languages::geo_maps.no_shippings"
msgid "Sorry, we couldn't find any shipping options for your location. Please contact us, and we'll see what we can do about it."
msgstr "Beklager, vi kunne ikke finde nogen forsendelsesmuligheder for din placering. Kontakt os venligst, så ser vi, hvad vi kan gøre ved det."

msgctxt "Languages::geo_maps.no_shippings_short"
msgid "Shipping to your location isn't available."
msgstr "Forsendelse til din placering er ikke tilgængelig."

msgctxt "Languages::geo_maps.text_settings_google_api_notice"
msgid "<div class=\"alert alert-warning\"><p>Google may charge API usage fees. To avoid unexpected charges, set usage limits and billing alerts, or keep limited funds on the payment card used for API billing.</p><p>Learn more about setting up API key <a target=\"_blank\" href=\"https://docs.cs-cart.com/latest/user_guide/addons/maps_and_geolocation/#configuration\">in the documentation</a>.</p></div>"
msgstr "<div class=\"alert alert-warning\"><p>Google kan opkræve gebyrer for API-brug. For at undgå uventede gebyrer skal du indstille brugsgrænser og faktureringsadvarsler eller have begrænsede midler på det betalingskort, der bruges til API-fakturering.</p><p>Få mere at vide om opsætning af API-nøgler <a target=\"_blank\" href=\"https://docs.cs-cart.com/latest/user_guide/addons/maps_and_geolocation/#configuration\">i dokumentationen</a>.</p></div>"

msgctxt "Languages::geo_maps.text_settings_yandex_api_notice"
msgid "<div class=\"alert alert-warning\"><p>Yandex may charge API usage fees. To avoid unexpected charges, keep limited funds in your Yandex account.</p><p>Learn more about setting up API key <a target=\"_blank\" href=\"https://docs.cs-cart.com/latest/user_guide/addons/maps_and_geolocation/#configuration\">in the documentation</a>.</p></div>"
msgstr "<div class=\"alert alert-warning\"><p>Yandex kan opkræve gebyrer for brug af API'er. For at undgå uventede gebyrer skal du have begrænsede midler på din Yandex-konto.</p><p>Få mere at vide om opsætning af API-nøgler <a target=\"_blank\" href=\"https://docs.cs-cart.com/latest/user_guide/addons/maps_and_geolocation/#configuration\">i dokumentationen</a>.</p></div>"

msgctxt "Languages::geo_maps.settings_is_configured_correctly_notice"
msgid "If you see the map here, everything is configured correctly, and the maps are working on the map provider end."
msgstr "Hvis du ser kortet her, er alt konfigureret korrekt, og kortene fungerer på kortudbyderens ende."

msgctxt "Languages::geo_maps.google_maps_cookie_title"
msgid "Google Maps"
msgstr "Google kort"

msgctxt "Languages::geo_maps.google_maps_cookie_description"
msgid "Google Maps is a service that allows us to show the maps and various locations on those maps, or automatically determine your location. Here is <a href=\"https://policies.google.com/privacy\" target=\"_blank\">Google privacy policy;</a> we also recommend Google's concise and comprehensive <a href=\"https://support.google.com/maps/answer/10400210\" target=\"_blank\">note on privacy</a>."
msgstr "Google Maps er en tjeneste, der giver os mulighed for at vise kortene og forskellige placeringer på disse kort eller automatisk bestemme din placering. Her er <a href=\"https://policies.google.com/privacy\" target=\"_blank\">Googles privatlivspolitik;</a> anbefaler vi også Googles kortfattede og omfattende <a href=\"https://support.google.com/maps/answer/10400210\" target=\"_blank\">note om privatliv</a>."

msgctxt "Languages::geo_maps.yandex_maps_cookie_title"
msgid "Yandex Maps"
msgstr "Yandex kort"

msgctxt "Languages::geo_maps.yandex_maps_cookie_description"
msgid "Yandex Maps is a service that allows us to show the maps and various locations on those maps, or automatically determine your location. Here is <a href=\"https://yandex.com/legal/confidential/\" target=\"_blank\">Yandex privacy policy</a>."
msgstr "Yandex Maps er en tjeneste, der giver os mulighed for at vise kortene og forskellige placeringer på disse kort eller automatisk bestemme din placering. Her er <a href=\"https://yandex.com/legal/confidential/\" target=\"_blank\">Yandex privatlivspolitik</a>."

