msgctxt "Languages::paypal_checkout.shipment_info_was_not_sent.tracking_number_empty"
msgid "Shipping info was not sent to PayPal because the tracking number is empty"
msgstr "لم يتم إرسال معلومات الشحن إلى PayPal لأن رقم التتبع فارغ"

msgctxt "Languages::paypal_checkout.shipment_info_was_not_sent.carrier_empty"
msgid "Shipping info was not sent to PayPal because the carrier is empty"
msgstr "لم يتم إرسال معلومات الشحن إلى PayPal لأن الناقل فارغ"

msgctxt "Languages::paypal_checkout.shipment_info_was_not_sent.no_capture_id"
msgid "Shipping info was not sent to PayPal because the capture id is missing, try again later"
msgstr "لم يتم إرسال معلومات الشحن إلى PayPal لأن معرف الالتقاط مفقود، حاول مرة أخرى لاحقًا"

msgctxt "Languages::paypal_checkout.shipment_info_was_not_sent.no_order_id"
msgid "Shipping info was not sent to PayPal because the PayPal order id is missing, try again later"
msgstr "لم يتم إرسال معلومات الشحن إلى PayPal لأن معرف طلب PayPal مفقود، حاول مرة أخرى لاحقًا"

msgctxt "Languages::paypal_checkout.send_shipping_address"
msgid "Send shipping address to PayPal"
msgstr "إرسال عنوان الشحن إلى PayPal"

msgctxt "Languages::paypal_checkout.send_shipping_address_tooltip"
msgid "Useful for fraud protection or shipping labels. Can cause issues with payment if the address provided by the customer isn't valid."
msgstr "مفيد للحماية من الاحتيال أو ملصقات الشحن. قد يتسبب في حدوث مشكلات في الدفع إذا كان العنوان الذي قدمه العميل غير صالح."

