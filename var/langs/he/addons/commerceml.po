msgctxt "Languages::commerceml.cml_catalog_product_feature_creation"
msgid "Product feature creation"
msgstr "יצירת תכונות מוצר"

msgctxt "Languages::commerceml.cml_catalog_product_feature_creation.y"
msgid "Create new features and variants from CRM automatically"
msgstr "צור תכונות ווריאציות חדשות מ-CRM באופן אוטומטי"

msgctxt "Languages::commerceml.cml_catalog_product_feature_creation.n"
msgid "Don't create features and variants from CRM until I check them"
msgstr "אל תיצור תכונות ווריאציות מ-CRM עד שאבדוק אותן"

msgctxt "Languages::commerceml.cml_catalog_category_creation"
msgid "Category creation"
msgstr "יצירת קטגוריה"

msgctxt "Languages::commerceml.cml_catalog_category_creation.y"
msgid "Create new categories from CRM automatically"
msgstr "צור קטגוריות חדשות מ-CRM באופן אוטומטי"

msgctxt "Languages::commerceml.cml_catalog_category_creation.n"
msgid "Don't create features and variants from CRM until I check them"
msgstr "אל תיצור תכונות ווריאציות מ-CRM עד שאבדוק אותן"

msgctxt "Languages::commerceml.cml_catalog_product_category_update_strategy"
msgid "If the category of a product changes in CRM"
msgstr "אם קטגוריית המוצר משתנה ב-CRM"

msgctxt "Languages::commerceml.cml_catalog_product_category_update_strategy.append"
msgid "Add the new category alongside the existing ones"
msgstr "הוסף את הקטגוריה החדשה לצד הקיימות"

msgctxt "Languages::commerceml.cml_catalog_product_category_update_strategy.replace_main"
msgid "Change the main category of the product"
msgstr "שנה את הקטגוריה העיקרית של המוצר"

msgctxt "Languages::commerceml.cml_catalog_product_category_update_strategy.ignore"
msgid "Ignore the change; assign a category only to new products"
msgstr "התעלם מהשינוי; הקצה קטגוריה רק למוצרים חדשים"

msgctxt "Languages::commerceml.cml_catalog_product_image_update_strategy"
msgid "If the image of a product changes in CRM"
msgstr "אם תמונת המוצר משתנה ב-CRM"

msgctxt "Languages::commerceml.cml_catalog_product_image_update_strategy.append"
msgid "Add the new image alongside the existing ones"
msgstr "הוסף את התמונה החדשה לצד הקיימות"

msgctxt "Languages::commerceml.cml_catalog_product_image_update_strategy.replace"
msgid "Replace all images of the product"
msgstr "החלף את כל התמונות של המוצר"

msgctxt "Languages::commerceml.cml_catalog_product_image_update_strategy.ignore"
msgid "Ignore the change; assign an image only to new products"
msgstr "התעלם מהשינוי; הקצה תמונה רק למוצרים חדשים"

msgctxt "Languages::commerceml.additional_settings_title"
msgid "Additional settings"
msgstr "הגדרות נוספות"

msgctxt "Languages::commerceml.field_import_only_for_new_products"
msgid "Import only for new products"
msgstr "ייבוא מוצרים חדשים בלבד"

msgctxt "Languages::commerceml.dont_import"
msgid "Don't import"
msgstr "אל תייבא"

msgctxt "Languages::commerceml.import.message.order.updated"
msgid "Order [local_id] was updated: Products id: [products];"
msgstr "הזמנה [local_id] עודכנה: מזהה מוצרים: [products];"

msgctxt "Languages::commerceml.import.message.order.status_updated"
msgid "Status for order [local_id] was updated: Old status: [old_status]; New status: [new_status];"
msgstr "סטטוס ההזמנה [local_id] עודכן: סטטוס ישן: [old_status]; סטטוס חדש: [new_status];"

msgctxt "Languages::commerceml.import.error.order.local_order_not_found"
msgid "Local order was not found"
msgstr "לא נמצאה הזמנה מקומית"

msgctxt "Languages::commerceml.import.error.order.local_product_not_found"
msgid "Was not found local equivalent of products"
msgstr "לא נמצאה מקבילה מקומית למוצרים"

msgctxt "Languages::commerceml.products_were_disabled_after_addon_was_activated"
msgid "We detected some duplicate entities (products, features, etc.) loaded from your CRM. They were created by mistake when the old CommerceML add-on was replaced with the new one. For your convenience, we've changed the status of the duplicates to \"Disabled\". For example, <a href=\"[href]\">here is the list of duplicate products which you can safely delete.</a>"
msgstr "זיהינו כמה ישויות כפולות (מוצרים, תכונות וכו') שהועלו ממערכת ה-CRM שלך. הן נוצרו בטעות כאשר התוסף הישן של CommerceML הוחלף בתוסף החדש. לנוחיותך, שינינו את סטטוס הכפילויות ל\"מושבת\". לדוגמה, <a href=\"[href]\">הנה רשימת המוצרים הכפולים שתוכל למחוק בבטחה.</a>"

msgctxt "Languages::commerceml.export_field_via_commerceml"
msgid "Export via CommerceML"
msgstr "ייצוא דרך CommerceML"

msgctxt "Languages::commerceml.tooltip.export_field_via_commerceml"
msgid "Field export in the orders file in CommerceML format"
msgstr "ייצוא שדות בקובץ ההזמנות בפורמט CommerceML"

msgctxt "Languages::commerceml.import.order.shipment_date_status"
msgid "Order status upon acquisition of shipment date"
msgstr "סטטוס ההזמנה בעת קבלת תאריך המשלוח"

msgctxt "Languages::commerceml.import.order.payment_date_status"
msgid "Order status upon acquisition of payment date"
msgstr "סטטוס ההזמנה בעת קבלת תאריך התשלום"

msgctxt "Languages::commerceml.import.order.status_mapping_information"
msgid "By default, the order status is taken from the <b>Статус заказа</b> attribute. If it is not there, the statuses will be determined by the date of payment and shipment. If both dates exist, shipment date will have higher priority."
msgstr "כברירת מחדל, סטטוס ההזמנה נלקח מהתכונה <b>Статус заказа</b> . אם היא לא מופיעה, הסטטוסים ייקבעו לפי תאריך התשלום והמשלוח. אם שני התאריכים קיימים, לתאריך המשלוח תהיה עדיפות גבוהה יותר."

msgctxt "Languages::commerceml.tooltip.export_field_via_commerceml_default_bs"
msgid "This is a standard field. It is always exported via CommerceML. Fields from the shipping address have priority over fields from the billing address."
msgstr "זהו שדה סטנדרטי. הוא תמיד מיוצא דרך CommerceML. לשדות מכתובת המשלוח יש עדיפות על פני שדות מכתובת החיוב."

msgctxt "Languages::commerceml.tooltip.export_field_via_commerceml_custom_bs"
msgid "Export this field via CommerceML. If you export the same field from the billing and shipping address, then shipping address takes priority."
msgstr "ייצא שדה זה דרך CommerceML. אם אתה מייצא את אותו שדה מכתובת החיוב ומכתובת המשלוח, כתובת המשלוח מקבלת עדיפות."

msgctxt "Languages::commerceml.tooltip.export_field_via_commerceml_default_contact_info"
msgid "This is a standard field. It is always exported via CommerceML."
msgstr "זהו שדה סטנדרטי. הוא תמיד מיוצא דרך CommerceML."

msgctxt "Languages::commerceml.tooltip.export_field_via_commerceml_custom_contact_info"
msgid "Export this field via CommerceML."
msgstr "ייצוא שדה זה דרך CommerceML."

msgctxt "Languages::commerceml.connection_instructions.mve"
msgid "<p>Here is the page where your vendors can connect their CRMs to your marketplace via CommerceML. Copy the link and share with your vendors.</p>"
msgstr "<p>זהו הדף שבו הספקים שלכם יכולים לחבר את מערכות ה-CRM שלהם לזירת המסחר שלכם דרך CommerceML. העתיקו את הקישור ושתפו אותו עם הספקים שלכם.</p>"

msgctxt "Languages::commerceml.connection_instructions.ult"
msgid "To connect your CRMs to CS-Cart, go to <b>Administration → <a href=\"[href]\">Sync data</a></b> and choose <b>CommerceML Integration.</b>"
msgstr "כדי לחבר את מערכות ה-CRM שלכם ל-CS-Cart, גשו אל <b>ניהול → <a href=\"[href]\">סנכרון נתונים</a></b> ובחרו <b>אינטגרציית CommerceML.</b>"

msgctxt "Languages::commerceml.the_file_does_not_exist"
msgid "The file [file] does not exist."
msgstr "הקובץ [file] אינו קיים."

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names"
msgid "Names of product features"
msgstr "שמות של תכונות המוצר"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names.internal"
msgid "Use names from CRM in CS-Cart admin panel"
msgstr "השתמש בשמות מ-CRM בפאנל הניהול של CS-Cart"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names.internal.tooltip"
msgid "Internal feature names in CS-Cart will always change match those in your CRM. You can safely edit display names for the storefront."
msgstr "שמות התכונות הפנימיות ב-CS-Cart תמיד ישתנו בהתאם לאלה שבמערכת ניהול קשרי הלקוחות (CRM). ניתן לערוך בבטחה את שמות התצוגה של חנות החנות."

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names.both"
msgid "Use names from CRM everywhere in CS-Cart"
msgstr "השתמש בשמות ממערכת CRM בכל מקום ב-CS-Cart"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names.both.tooltip"
msgid "Feature names in CS-Cart will change to match the names in your CRM. Any changes to feature names on the CS-Cart end will be lost."
msgstr "שמות התכונות ב-CS-Cart ישתנו כך שיתאימו לשמות במערכת ה-CRM שלך. כל שינוי בשמות התכונות בצד ה-CS-Cart יאבד."

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names.no"
msgid "Do not use names from CRM"
msgstr "אין להשתמש בשמות ממערכת ניהול קשרי לקוחות (CRM)"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_names.no.tooltip"
msgid "Feature names will come from CRM only on first import. Subsequent changes in the CRM won't affect existing feature names in CS-Cart."
msgstr "שמות התכונות יגיעו מ-CRM רק בייבוא הראשון. שינויים נוספים ב-CRM לא ישפיעו על שמות התכונות הקיימים ב-CS-Cart."

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names"
msgid "Names of feature variants"
msgstr "שמות של גרסאות תכונה"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names.yes"
msgid "Use names from CRM"
msgstr "השתמש בשמות מ-CRM"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names.yes.tooltip"
msgid "Feature variant names will always be updated from the CRM. Your edits will be lost on import."
msgstr "שמות גרסאות התכונה יעודכנו תמיד ממערכת ה-CRM. העריכות שלך יאבדו בעת הייבוא."

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names.no"
msgid "Do not use names from CRM"
msgstr "אין להשתמש בשמות ממערכת ניהול קשרי לקוחות (CRM)"

msgctxt "Languages::commerceml.cml_catalog_sync_feature_variant_names.no.tooltip"
msgid "Feature variant names will come from CRM only on first import. Useful if you plan to change their names in CS-Cart."
msgstr "שמות גרסאות התכונה יגיעו מ-CRM רק בייבוא הראשון. שימושי אם אתם מתכננים לשנות את שמם ב-CS-Cart."

msgctxt "Languages::commerceml.cml_catalog_sync_feature.vendor_notice"
msgid "The settings about the names of product features and their variants only affect the product features that belong to you, not to the marketplace."
msgstr "ההגדרות לגבי שמות תכונות המוצר והווריאציות שלהן משפיעות רק על תכונות המוצר ששייכות לך, לא על השוק."

