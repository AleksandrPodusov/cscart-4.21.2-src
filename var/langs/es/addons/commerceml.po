msgstr "Exporta este campo a través de CommerceML."

msgctxt "Languages::commerceml.connection_instructions.mve"
msgid "<p>Here is the page where your vendors can connect their CRMs to your marketplace via CommerceML. Copy the link and share with your vendors.</p>"
msgstr "<p>Esta es la página donde tus proveedores pueden conectar sus CRM a tu marketplace a través de CommerceML. Copia el enlace y compártelo con tus proveedores.</p>"

msgctxt "Languages::commerceml.connection_instructions.ult"
msgid "To connect your CRMs to CS-Cart, go to <b>Administration → <a href=\"[href]\">Sync data</a></b> and choose <b>CommerceML Integration.</b>"
msgstr "Para conectar sus CRM a CS-Cart, vaya a <b>Administración → <a href=\"[href]\">Sincronizar datos</a></b> y elija <b>Integración de CommerceML.</b>"

msgctxt "Languages::commerceml.the_file_does_not_exist"
