msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.tooltip"
msgid "Determines where product variations will get their names during import. After the import, you'll be able to edit their names in CS-Cart as you see fit."
msgstr "تعیین می‌کند که نام انواع محصولات در هنگام وارد کردن از کجا گرفته شود. پس از وارد کردن، می‌توانید نام آنها را در CS-Cart به دلخواه ویرایش کنید."

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.automatically"
msgid "Choose automatically"
msgstr "به طور خودکار انتخاب کنید"

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.automatically.tooltip"
msgid "If any of a product's variations are \"separate products\", then all variations of that product will use unique names from offers.xml"
msgstr "اگر هر یک از تغییرات یک محصول، «محصولات جداگانه» باشند، تمام تغییرات آن محصول از نام‌های منحصر به فرد از offers.xml استفاده خواهند کرد."

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.import"
msgid "Use catalog names"
msgstr "استفاده از نام کاتالوگ‌ها"

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.import.tooltip"
msgid "All variations of a product will use their common catalog name from import.xml"
msgstr "تمام تغییرات یک محصول از نام کاتالوگ مشترک خود از import.xml استفاده خواهند کرد."

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.offers"
msgid "Use offer names"
msgstr "از نام‌های پیشنهادی استفاده کنید"

msgctxt "Languages::commerceml.cml_catalog_use_product_variation_name_from.offers.tooltip"
