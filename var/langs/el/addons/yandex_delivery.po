msgstr "Yandex Delivery: Enter the recipient address."

msgctxt "Languages::yandex_delivery.dimensions_required"
msgid "Yandex Delivery: Enter default parcel dimensions in the shipping method settings or specify box dimensions for products."
msgstr "Yandex Delivery: Enter default parcel dimensions in the shipping method settings or specify box dimensions for products."

