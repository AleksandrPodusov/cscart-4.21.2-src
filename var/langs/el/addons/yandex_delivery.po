msgstr "Pickup point"

msgctxt "Languages::yandex_delivery.station_type.limits_note"
msgid "Volume and size limits are listed in the Yandex Delivery <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/rules\" target=\"_blank\" rel=\"noopener noreferrer\">shipping rules</a>."
msgstr "Volume and size limits are listed in the Yandex Delivery <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/rules\" target=\"_blank\" rel=\"noopener noreferrer\">shipping rules</a>."

