msgstr "Default parcel dimensions"

msgctxt "Languages::yandex_delivery.dimensions"
msgid "Length, width, height"
msgstr "Length, width, height"

msgctxt "Languages::yandex_delivery.dimensions.tooltip"
msgid "Used when a product has no box dimensions of its own. A product's own dimensions apply only together with \"items in box\"."
msgstr "Used when a product has no box dimensions of its own. A product's own dimensions apply only together with \"items in box\"."

msgctxt "Languages::yandex_delivery.dimensions_all_required"
msgid "Fill in all three: Yandex Delivery will not quote a rate without the length, width and height."
msgstr "Fill in all three: Yandex Delivery will not quote a rate without the length, width and height."

