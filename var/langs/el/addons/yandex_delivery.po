msgctxt "Addons::name::yandex_delivery"
msgid "Yandex Delivery"
msgstr "Yandex Delivery"

msgctxt "Addons::description::yandex_delivery"
msgid "Integration with Yandex Delivery for next-day shipping in Russia."
msgstr "Integration with Yandex Delivery for next-day shipping in Russia."

msgctxt "Languages::yandex_delivery.carrier"
msgid "Yandex Delivery"
msgstr "Yandex Delivery"

msgctxt "Languages::yandex_delivery.auth_token"
msgid "Bearer token"
msgstr "Bearer token"

msgctxt "Languages::yandex_delivery.auth_token.tooltip"
msgid "Get the token in the <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/api/other-day/access\" target=\"_blank\" rel=\"noopener noreferrer\">Yandex Delivery account profile</a>."
msgstr "Get the token in the <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/api/other-day/access\" target=\"_blank\" rel=\"noopener noreferrer\">Yandex Delivery account profile</a>."

msgctxt "Languages::yandex_delivery.auth_token_required"
msgid "Yandex Delivery: Enter the Bearer token in the shipping method settings."
msgstr "Yandex Delivery: Enter the Bearer token in the shipping method settings."

msgctxt "Languages::yandex_delivery.connection"
msgid "Connection"
msgstr "Connection"

msgctxt "Languages::yandex_delivery.environment"
msgid "Environment"
msgstr "Environment"

msgctxt "Languages::yandex_delivery.environment.production"
msgid "Production"
msgstr "Production"

msgctxt "Languages::yandex_delivery.environment.sandbox"
msgid "Sandbox"
msgstr "Sandbox"

msgctxt "Languages::yandex_delivery.environment.tooltip"
msgid "The sandbox and production environments use different tokens, and a warehouse from one environment does not exist in the other. After switching, pick the warehouse again."
msgstr "The sandbox and production environments use different tokens, and a warehouse from one environment does not exist in the other. After switching, pick the warehouse again."

msgctxt "Languages::yandex_delivery.handover"
msgid "Handover to Yandex"
msgstr "Handover to Yandex"

msgctxt "Languages::yandex_delivery.handover_scheme"
msgid "Handover scheme"
msgstr "Handover scheme"

msgctxt "Languages::yandex_delivery.handover_scheme.courier"
msgid "A Yandex courier picks parcels up at my warehouse"
msgstr "A Yandex courier picks parcels up at my warehouse"

msgctxt "Languages::yandex_delivery.handover_needs_token"
msgid "To make this section available, save the shipping method with a valid token."
msgstr "To make this section available, save the shipping method with a valid token."

msgctxt "Languages::yandex_delivery.warehouses_stale"
msgid "The token or the environment has changed. The warehouse lists below still come from the previous one — save the shipping method to reload them."
msgstr "The token or the environment has changed. The warehouse lists below still come from the previous one — save the shipping method to reload them."

msgctxt "Languages::yandex_delivery.warehouse_reset"
msgid "Yandex Delivery: the selected warehouse was cleared because the token or the environment has changed. Warehouse IDs only work in the account they were picked in, so choose a warehouse again."
msgstr "Yandex Delivery: the selected warehouse was cleared because the token or the environment has changed. Warehouse IDs only work in the account they were picked in, so choose a warehouse again."

msgctxt "Languages::yandex_delivery.check"
msgid "Check connection"
msgstr "Check connection"

msgctxt "Languages::yandex_delivery.check.token_ok"
msgid "Yandex Delivery accepted the token. Warehouses on the account: [count]."
msgstr "Yandex Delivery accepted the token. Warehouses on the account: [count]."

msgctxt "Languages::yandex_delivery.check.token_failed"
msgid "Could not check the connection: [error]"
msgstr "Could not check the connection: [error]"

msgctxt "Languages::yandex_delivery.handover_scheme.dropoff"
msgid "I bring parcels to a Yandex drop-off point myself"
msgstr "I bring parcels to a Yandex drop-off point myself"

msgctxt "Languages::yandex_delivery.source_platform_station_id"
msgid "My warehouse"
msgstr "My warehouse"

msgctxt "Languages::yandex_delivery.source_platform_station_id.tooltip"
msgid "Warehouses are created in the Yandex Delivery account: add the address in the Addresses section, then open Shipment calendar and pick it there. <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/add-address\" target=\"_blank\" rel=\"noopener noreferrer\">Yandex instructions</a>."
msgstr "Warehouses are created in the Yandex Delivery account: add the address in the Addresses section, then open Shipment calendar and pick it there. <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/add-address\" target=\"_blank\" rel=\"noopener noreferrer\">Yandex instructions</a>."

msgctxt "Languages::yandex_delivery.source_platform_station_id_required"
msgid "Yandex Delivery: Select a shipping warehouse in the shipping method settings."
msgstr "Yandex Delivery: Select a shipping warehouse in the shipping method settings."

msgctxt "Languages::yandex_delivery.pickup_unavailable"
msgid "Yandex returns no pickup dates for this warehouse. Check that its city is in the <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/rules#cities\" target=\"_blank\" rel=\"noopener noreferrer\">list of cities with courier pickup</a> and that the address falls inside the service zone on the map. Otherwise switch to bringing parcels to a Yandex warehouse yourself."
msgstr "Yandex returns no pickup dates for this warehouse. Check that its city is in the <a class=\"underline\" href=\"https://yandex.ru/support/delivery-profile/ru/other-day/rules#cities\" target=\"_blank\" rel=\"noopener noreferrer\">list of cities with courier pickup</a> and that the address falls inside the service zone on the map. Otherwise switch to bringing parcels to a Yandex warehouse yourself."

msgctxt "Languages::yandex_delivery.pickup_not_scheduled"
msgid "Pickup from this warehouse is available but not scheduled. Schedule it in the <a class=\"underline\" href=\"https://dostavka.yandex.ru/account/shipment\" target=\"_blank\" rel=\"noopener noreferrer\">Shipment calendar</a>: without a scheduled pickup Yandex quotes no price and the shipping method stays hidden at checkout."
msgstr "Pickup from this warehouse is available but not scheduled. Schedule it in the <a class=\"underline\" href=\"https://dostavka.yandex.ru/account/shipment\" target=\"_blank\" rel=\"noopener noreferrer\">Shipment calendar</a>: without a scheduled pickup Yandex quotes no price and the shipping method stays hidden at checkout."

msgctxt "Languages::yandex_delivery.dropoff_city"
msgid "City"
msgstr "City"

msgctxt "Languages::yandex_delivery.dropoff_city.tooltip"
msgid "Defines where to look for drop-off points. The region is shown next to each city because the same name occurs several times across the country."
msgstr "Defines where to look for drop-off points. The region is shown next to each city because the same name occurs several times across the country."

